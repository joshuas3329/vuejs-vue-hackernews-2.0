{
  "name": "vue-hackernews-2.0",
  "description": "A Vue.js project",
  "author": "Evan You <yyx990803@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "node server",
    "start": "cross-env NODE_ENV=production node server",
    "build": "rimraf dist && npm run build:client && npm run build:server",
    "build:client": "cross-env NODE_ENV=production webpack --config build/webpack.client.config.js --progress",
    "build:server": "cross-env NODE_ENV=production webpack --config build/webpack.server.config.js --progress",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": ">=18.0",
    "npm": ">=8.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cross-env": "^7.0.3",
    "express": "^4.21.2",
    "firebase": "^11.8.1",
    "lru-cache": "^10.4.3",
    "route-cache": "^0.7.1",
    "serve-favicon": "^2.5.1",
    "vue": "^2.7.16",
    "vue-router": "^3.6.5",
    "vue-server-renderer": "^2.7.16",
    "vuex": "^3.6.2",
    "vuex-router-sync": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^9.2.1",
    "chokidar": "^4.0.3",
    "css-loader": "^6.11.0",
    "file-loader": "^6.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "rimraf": "^5.0.10",
    "stylus": "^0.64.0",
    "stylus-loader": "^7.1.3",
    "terser-webpack-plugin": "^5.6.0",
    "url-loader": "^4.1.1",
    "vue-loader": "^15.11.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-middleware": "^6.1.3",
    "webpack-hot-middleware": "^2.26.1",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0",
    "workbox-webpack-plugin": "^7.4.1"
  }
}
